generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id @default(uuid()) @map("user_id")
  sellerId            String?            @unique @map("seller_id")
  name                String             @map("first_name")
  lastName            String?            @map("last_name")
  nickname            String?            @map("nickname")
  email               String?            @unique @map("email")
  mobile              String             @unique @map("phone")
  password            String             @map("password_hash")
  companyName         String?            @map("company_name")
  gstin               String?            @map("gstin")
  panNumber           String?            @map("pan_number")
  storageType         StorageType        @default(SELLER) @map("storage_type")
  address             String?            @map("address")
  pincode             String?            @map("pincode")
  city                String?            @map("city")
  state               String?            @map("state")
  country             String?            @default("India") @map("country")
  onboardStatus       UserOnboardStatus  @default(PENDING) @map("onboard_status")
  role                UserRole           @default(BUYER) @map("legacy_role")
  roleId              String?            @map("role_id")
  status              UserStatus         @default(ACTIVE) @map("status")
  refreshToken        String?            @map("legacy_refresh_token")
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  phoneVerifiedAt     DateTime?          @map("phone_verified_at")
  lastLoginAt         DateTime?          @map("last_login_at")
  passwordChangedAt   DateTime?          @map("password_changed_at")
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  deletedAt           DateTime?          @map("deleted_at")
  buyer               Buyer?
  otps                OtpVerification[]
  refreshTokens       RefreshToken[]
  seller              Seller?
  devices             UserDevice[]
  loginHistories      UserLoginHistory[]
  sessions            UserSession[]
  userRole            Role?              @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([onboardStatus])
  @@map("users")
}

model Role {
  id           String           @id @default(uuid()) @map("role_id")
  name         String           @unique @map("role_name")
  code         String           @unique @map("role_code")
  description  String?          @map("description")
  isDefault    Boolean          @default(false) @map("is_default")
  isSystemRole Boolean          @default(false) @map("is_system_role")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  permissions  RolePermission[]
  users        User[]

  @@index([code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @map("permission_id")
  name        String           @unique @map("permission_name")
  code        String           @unique @map("permission_code")
  module      String           @map("module")
  action      String?          @map("action")
  description String?          @map("description")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @map("id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  grantedAt    DateTime   @default(now()) @map("granted_at")
  grantedBy    String?    @map("granted_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String             @id @default(uuid()) @map("session_id")
  userId           String             @map("user_id")
  deviceId         String?            @map("device_id")
  accessTokenJti   String?            @unique @map("access_token_jti")
  sessionTokenHash String             @unique @map("session_token_hash")
  ipAddress        String?            @map("ip_address")
  userAgent        String?            @map("user_agent")
  isActive         Boolean            @default(true) @map("is_active")
  lastActivityAt   DateTime           @default(now()) @map("last_activity_at")
  expiresAt        DateTime           @map("expires_at")
  revokedAt        DateTime?          @map("revoked_at")
  revocationReason String?            @map("revocation_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  refreshTokens    RefreshToken[]
  loginHistories   UserLoginHistory[]
  device           UserDevice?        @relation(fields: [deviceId], references: [id])
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([isActive])
  @@index([expiresAt])
  @@map("user_sessions")
}

model UserDevice {
  id                   String             @id @default(uuid()) @map("device_id")
  userId               String             @map("user_id")
  fcmToken             String?            @map("fcm_token")
  apnsToken            String?            @map("apns_token")
  deviceUuid           String?            @map("device_uuid")
  deviceIdentifier     String?            @map("device_identifier")
  deviceOs             DeviceOS           @default(UNKNOWN) @map("device_os")
  deviceName           String?            @map("device_name")
  deviceModel          String?            @map("device_model")
  appVersion           String?            @map("app_version")
  appBuildNumber       String?            @map("app_build_number")
  platform             String?            @map("platform")
  isActive             Boolean            @default(true) @map("is_active")
  notificationsEnabled Boolean            @default(true) @map("notifications_enabled")
  lastSeenAt           DateTime           @default(now()) @map("last_seen_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  refreshTokens        RefreshToken[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginHistories       UserLoginHistory[]
  sessions             UserSession[]

  @@index([userId])
  @@index([deviceUuid])
  @@index([fcmToken])
  @@index([apnsToken])
  @@map("user_devices")
}

model RefreshToken {
  id                String      @id @default(uuid()) @map("token_id")
  userId            String      @map("user_id")
  sessionId         String      @map("session_id")
  deviceId          String?     @map("device_id")
  tokenHash         String      @unique @map("token_hash")
  tokenFamily       String?     @map("token_family")
  parentTokenId     String?     @map("parent_token_id")
  isRevoked         Boolean     @default(false) @map("is_revoked")
  expiresAt         DateTime    @map("expires_at")
  revokedAt         DateTime?   @map("revoked_at")
  replacedByTokenId String?     @map("replaced_by_token_id")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @default(now()) @updatedAt @map("updated_at")
  device            UserDevice? @relation(fields: [deviceId], references: [id])
  session           UserSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@index([tokenFamily])
  @@index([expiresAt])
  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

model OtpVerification {
  id             String            @id @default(uuid()) @map("otp_id")
  userId         String?           @map("user_id")
  identifier     String            @map("identifier")
  identifierType OtpIdentifierType @default(PHONE) @map("identifier_type")
  otpHash        String            @map("otp_hash")
  purpose        OtpPurpose        @default(LOGIN) @map("purpose")
  channel        OtpChannel        @default(SMS) @map("channel")
  attemptCount   Int               @default(0) @map("attempt_count")
  maxAttempts    Int               @default(3) @map("max_attempts")
  resendCount    Int               @default(0) @map("resend_count")
  maxResendCount Int               @default(3) @map("max_resend_count")
  isVerified     Boolean           @default(false) @map("is_verified")
  expiresAt      DateTime          @map("expires_at")
  verifiedAt     DateTime?         @map("verified_at")
  usedAt         DateTime?         @map("used_at")
  lastSentAt     DateTime          @default(now()) @map("last_sent_at")
  blockedUntil   DateTime?         @map("blocked_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([purpose])
  @@index([expiresAt])
  @@index([isVerified])
  @@map("otp_verifications")
}

model UserLoginHistory {
  id            String       @id @default(uuid()) @map("login_id")
  userId        String?      @map("user_id")
  identifier    String       @map("identifier")
  loginMethod   LoginMethod  @default(PHONE_PASSWORD) @map("login_method")
  status        LoginStatus  @default(SUCCESS) @map("status")
  failureReason String?      @map("failure_reason")
  sessionId     String?      @map("session_id")
  deviceId      String?      @map("device_id")
  ipAddress     String?      @map("ip_address")
  userAgent     String?      @map("user_agent")
  deviceName    String?      @map("device_name")
  location      String?      @map("location")
  attemptedAt   DateTime     @default(now()) @map("attempted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  device        UserDevice?  @relation(fields: [deviceId], references: [id])
  session       UserSession? @relation(fields: [sessionId], references: [id])
  user          User?        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([identifier])
  @@index([status])
  @@index([attemptedAt])
  @@map("user_login_histories")
}

model Seller {
  id           String   @id @default(uuid()) @map("seller_pk")
  userId       String   @unique @map("user_id")
  businessName String   @map("business_name")
  gstNumber    String?  @map("gst_number")
  address      String?  @map("address")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id])

  @@map("sellers")
}

model Buyer {
  id        String   @id @default(uuid()) @map("buyer_pk")
  userId    String   @unique @map("user_id")
  address   String?  @map("address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("buyers")
}

enum UserRole {
  ADMIN
  SELLER
  BUYER
  NEST_WORKER
  DELIVERY_PARTNER
  SUPPORT
  SELLER_OWNER
  SELLER_STAFF
  ACCOUNT_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  PENDING
}

enum StorageType {
  SELLER
  HAATZA
}

enum UserOnboardStatus {
  PENDING
  ACTIVE
  INACTIVE
  REJECTED
  SUSPENDED
}

enum DeviceOS {
  ANDROID
  IOS
  WEB
  UNKNOWN
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  FORGOT_PASSWORD
  EMAIL_VERIFICATION
  MOBILE_VERIFICATION
}

enum OtpChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum OtpIdentifierType {
  EMAIL
  PHONE
}

enum OtpType {
  LOGIN
  REGISTER
  FORGOT_PASSWORD
  RESET_PASSWORD
  EMAIL_VERIFICATION
  PHONE_VERIFICATION
  CHANGE_EMAIL
  CHANGE_PHONE
}

enum LoginMethod {
  EMAIL_PASSWORD
  PHONE_PASSWORD
  OTP_EMAIL
  OTP_PHONE
  REFRESH_TOKEN
}

enum LoginStatus {
  SUCCESS
  FAILED
  BLOCKED
  LOCKED
  TOKEN_REJECTED
}

enum ContactEnquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model ContactEnquiry {
  id        String               @id @default(uuid())
  firstName String               @map("first_name") @db.VarChar(100)
  phone     String               @db.VarChar(20)
  email     String?              @db.VarChar(255)
  city      String               @db.VarChar(100)
  message   String?              @db.Text
  status    ContactEnquiryStatus @default(NEW)
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("contact_enquiries")
}

model Category {
  id          String     @id @default(uuid()) @map("category_id")
  name        String     @map("name")
  slug        String     @unique @map("slug")
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  fields      Json?      @map("fields")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id                  String     @id @default(uuid()) @map("product_id")
  sellerId            String     @map("seller_id")
  categoryId          String?    @map("category_id")
  category            Category?  @relation(fields: [categoryId], references: [id])
  title               String     @map("title")
  description         String?    @map("description")
  price               Float      @map("price")
  sku                 String     @unique @map("sku")
  inventory           Int        @default(0) @map("inventory")
  mediaUrls           String[]   @map("media_urls")
  videoUrls           String[]   @map("video_urls")
  influencerBranding Boolean    @default(false) @map("influencer_branding")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@index([sellerId])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id             String      @id @default(uuid()) @map("order_id")
  sellerId       String      @map("seller_id")
  buyerId        String?     @map("buyer_id")
  status         String      @default("PENDING") @map("status")
  totalAmount    Float       @map("total_amount")
  shippingAmount Float       @default(0.0) @map("shipping_amount")
  deliveryAddress Json?      @map("delivery_address")
  awbNumber      String?     @map("awb_number")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([sellerId])
  @@map("orders")
}

model OrderReturn {
  id          String   @id @default(uuid()) @map("return_id")
  orderId     String   @map("order_id")
  sellerId    String   @map("seller_id")
  reason      String   @map("reason")
  status      String   @default("REQUESTED") @map("status")
  isExchange  Boolean  @default(false) @map("is_exchange")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@map("order_returns")
}

model Claim {
  id          String   @id @default(uuid()) @map("claim_id")
  sellerId    String   @map("seller_id")
  orderId     String?  @map("order_id")
  subject     String   @map("subject")
  description String   @map("description")
  status      String   @default("OPEN") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@map("claims")
}

model Wallet {
  id           String              @id @default(uuid()) @map("wallet_id")
  sellerId     String              @unique @map("seller_id")
  balance      Float               @default(0.0) @map("balance")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid()) @map("transaction_id")
  walletId    String   @map("wallet_id")
  wallet      Wallet   @relation(fields: [walletId], references: [id])
  amount      Float    @map("amount")
  type        String   @map("type")
  description String?  @map("description")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([walletId])
  @@map("wallet_transactions")
}

model Invoice {
  id          String   @id @default(uuid()) @map("invoice_id")
  sellerId    String   @map("seller_id")
  invoiceNo   String   @unique @map("invoice_no")
  amount      Float    @map("amount")
  taxAmount   Float    @default(0.0) @map("tax_amount")
  pdfUrl      String?  @map("pdf_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("invoices")
}

model Campaign {
  id          String   @id @default(uuid()) @map("campaign_id")
  sellerId    String   @map("seller_id")
  name        String   @map("name")
  budget      Float    @map("budget")
  status      String   @default("ACTIVE") @map("status")
  productIds  String[] @map("product_ids")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@map("campaigns")
}

model Notification {
  id        String   @id @default(uuid()) @map("notification_id")
  sellerId  String   @map("seller_id")
  title     String   @map("title")
  message   String   @map("message")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("notifications")
}

model SupportTicket {
  id          String   @id @default(uuid()) @map("ticket_id")
  sellerId    String   @map("seller_id")
  subject     String   @map("subject")
  description String   @map("description")
  status      String   @default("OPEN") @map("status")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sellerId])
  @@map("support_tickets")
}

model SubscriptionPlan {
  id          String   @id @default(uuid()) @map("plan_id")
  name        String   @map("name")
  price       Float    @map("price")
  duration    String   @map("duration")
  features    Json?    @map("features")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("subscription_plans")
}

model SellerSubscription {
  id        String   @id @default(uuid()) @map("subscription_id")
  sellerId  String   @unique @map("seller_id")
  planId    String   @map("plan_id")
  status    String   @default("ACTIVE") @map("status")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("seller_subscriptions")
}

model Referral {
  id            String   @id @default(uuid()) @map("referral_id")
  referrerId    String   @map("referrer_id")
  referredEmail String   @map("referred_email")
  referralCode  String   @map("referral_code")
  status        String   @default("PENDING") @map("status")
  rewardAmount  Float    @default(0.0) @map("reward_amount")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([referrerId])
  @@map("referrals")
}

model HaatzUpVideo {
  id         String   @id @default(uuid()) @map("video_id")
  sellerId   String   @map("seller_id")
  videoUrl   String   @map("video_url")
  hashtags   String[] @map("hashtags")
  productIds String[] @map("product_ids")
  viewsCount Int      @default(0) @map("views_count")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("haatzup_videos")
}

model Warehouse {
  id        String   @id @default(uuid()) @map("warehouse_id")
  sellerId  String   @map("seller_id")
  name      String   @map("name")
  address   String   @map("address")
  pincode   String   @map("pincode")
  city      String   @map("city")
  state     String   @map("state")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("warehouses")
}
