  createdDate          DateTime  @default(now()) @map("created_date")
  updatedDate          DateTime  @default(now()) @updatedAt @map("updated_date")
  owner                String?   @map("owner")

  @@index([module, status])
  @@index([warehouseId, module, status])
  @@index([expireDate], map: "idx_appbar_categories_expire_date")
  @@index([module, status], map: "idx_appbar_categories_module_status")
  @@index([warehouseId, module, status], map: "idx_appbar_categories_wh_mod_stat")
  @@map("appbar_categories")
}

