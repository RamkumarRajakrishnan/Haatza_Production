generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String             @id @default(uuid()) @map("user_id")
  sellerId            String?            @unique @map("seller_id")
  name                String             @map("first_name")
  gender              String?            @map("gender")
  email               String?            @unique @map("email")
  mobile              String             @unique @map("phone")
  password            String             @map("password_hash")
  companyName         String?            @map("company_name")
  gstin               String?            @map("gstin")
  panNumber           String?            @map("pan_number")
  address             String?            @map("address")
  pincode             String?            @map("pincode")
  city                String?            @map("city")
  state               String?            @map("state")
  country             String?            @map("country")
  roleId              String?            @map("role_id")
  emailVerifiedAt     DateTime?          @map("email_verified_at")
  phoneVerifiedAt     DateTime?          @map("phone_verified_at")
  lastLoginAt         DateTime?          @map("last_login_at")
  passwordChangedAt   DateTime?          @map("password_changed_at")
  failedLoginAttempts Int                @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?          @map("locked_until")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  status              UserStatus         @default(ACTIVE) @map("status")
  isBuyer             Boolean            @default(true) @map("is_buyer")
  sellerOnboardStatus UserOnboardStatus  @default(PENDING) @map("sellerOnboard_status")
  role                UserRole           @default(BUYER) @map("role")
  isSeller            Boolean            @default(false) @map("is_seller")
  isEmployee          Boolean            @default(false) @map("is_employee")
  refresh_token       String?
  buyer               Buyer?
  otps                OtpVerification[]
  loginHistories      UserLoginHistory[]
  userPageRoles       UserPageRole[]
  userRoles           UserRoleMapping[]
  sessions            UserSession[]
  userRole            Role?              @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([sellerOnboardStatus])
  @@map("users")
}

model Role {
  id           String           @id @default(uuid()) @map("role_id")
  name         String           @unique @map("role_name")
  code         String           @unique @map("role_code")
  description  String?          @map("description")
  isDefault    Boolean          @default(false) @map("is_default")
  isSystemRole Boolean          @default(false) @map("is_system_role")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  permissions  RolePermission[]
  users        User[]

  @@index([code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @map("permission_id")
  name        String           @unique @map("permission_name")
  code        String           @unique @map("permission_code")
  module      String           @map("module")
  action      String?          @map("action")
  description String?          @map("description")
  isActive    Boolean          @default(true) @map("is_active")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]

  @@index([code])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @map("id")
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  grantedAt    DateTime   @default(now()) @map("granted_at")
  grantedBy    String?    @map("granted_by")
  createdAt    DateTime   @default(now()) @map("created_at")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserSession {
  id               String   @id @default(uuid()) @map("session_id")
  userId           String   @map("user_id")
  deviceId         String?  @map("device_id")
  ipAddress        String?  @map("ip_address")
  userAgent        String?  @map("user_agent")
  isActive         Boolean  @default(true) @map("is_active")
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  expiresAt        DateTime @map("expires_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  refreshTokenHash String   @unique @map("refresh_token_hash")
  deviceName       String?  @map("device_name")
  platform         String?  @map("platform")
  osVersion        String?  @map("os_version")
  appVersion       String?  @map("app_version")
  pushToken        String?  @map("push_token")
  deviceType       String?  @map("device_type")
  identifier       String?  @map("identifier")
  refreshToken     String?  @map("refresh_token")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deviceId])
  @@index([refreshTokenHash])
  @@index([isActive, expiresAt])
  @@index([userId], map: "idx_user_sessions_user_id")
  @@map("user_sessions")
}

model OtpVerification {
  id             String            @id @default(uuid()) @map("otp_id")
  userId         String?           @map("user_id")
  identifier     String            @map("identifier")
  otpHash        String            @map("otp_hash")
  isVerified     Boolean           @default(false) @map("is_verified")
  expiresAt      DateTime          @map("expires_at")
  verifiedAt     DateTime?         @map("verified_at")
  usedAt         DateTime?         @map("used_at")
  lastSentAt     DateTime          @default(now()) @map("last_sent_at")
  blockedUntil   DateTime?         @map("blocked_until")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @default(now()) @updatedAt @map("updated_at")
  identifierType OtpIdentifierType @default(PHONE) @map("identifier_type")
  purpose        OtpPurpose        @default(LOGIN) @map("purpose")
  channel        OtpChannel        @default(SMS) @map("channel")
  user           User?             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier])
  @@index([purpose])
  @@index([expiresAt])
  @@index([isVerified])
  @@index([identifier], map: "idx_otp_verifications_identifier")
  @@map("otp_verifications")
}

model Buyer {
  id        String   @id @default(uuid()) @map("buyer_pk")
  userId    String   @unique @map("user_id")
  address   String?  @map("address")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id])

  @@map("buyers")
}

model Product {
  id                     String    @id @default(uuid()) @map("product_id")
  mainMedia              String?   @map("main_media")
  oneRsStore             Boolean?  @default(false) @map("one_rs_store")
  productImages          Json?     @map("product_images")
  name                   String    @map("name")
  searchKeywords         String[]  @map("search_keywords")
  subCategory            String?   @map("sub_category")
  subCategoryId          String?   @map("sub_category_id")
  brand                  String?   @map("brand")
  inventory              Int       @default(0) @map("inventory")
  variantPrice           Json?     @map("variant_price")
  wixProductId           String?   @map("wix_product_id")
  newVariantPrice        Json?     @map("new_variant_price")
  mrp                    Float?    @map("mrp")
  onsalePrice            Float?    @map("onsale_price")
  cod                    Float?    @map("cod")
  upi                    Float?    @map("upi")
  price                  Float?    @map("price")
  discount               Json?     @map("discount")
  status                 String?   @map("status")
  deliveryCharges        Boolean?  @map("delivery_charges")
  mainCategory           String?   @map("main_category")
  sellerId               String?   @map("seller_id")
  shippingWeight         Float?    @map("shipping_weight")
  collections            String[]  @map("collections")
  sellerPincode          String?   @map("seller_pincode")
  createdDate            DateTime? @map("created_date")
  updatedDate            DateTime? @map("updated_date")
  owner                  String?   @map("owner")
  productOptions         Json?     @map("product_options")
  additionalInfoSections Json?     @map("additional_info_sections")
  activeAd               Boolean?  @default(false) @map("active_ad")
  averageCpc             Float?    @map("average_cpc")
  priorityScore          Int?      @map("priority_score")
  campaignId             String?   @map("campaign_id")
  reach                  Int?      @map("reach")
  impression             Int?      @map("impression")
  clicks                 Int?      @map("clicks")
  sales                  Int?      @map("sales")
  revenue                Float?    @map("revenue")
  categoryName           String[]  @map("category_name")
  sku                    String?   @map("sku")
  productType            String?   @map("product_type")
  manageVariants         Boolean?  @map("manage_variants")
  ribbon                 String?   @map("ribbon")
  trackInventory         Boolean?  @map("track_inventory")
  influencerBranding     Boolean?  @map("influencer_branding")
  haatzaVerified         Boolean?  @map("haatza_verified")
  promotionPhotos        String[]  @map("promotion_photos")
  paymentType            String?   @map("payment_type")
  productReturn          String?   @map("product_return")
  sizeChart              String?   @map("size_chart")
  description            String?   @map("description")
  gstSeller              Float?    @map("gst_seller")
  upiPaymentDiscount     Float?    @map("upi_payment_discount")
  manageListingProducts  String?   @map("manage_listing_products")
  sellAndEarnCommission  Float?    @map("sell_and_earn_commission")
  sellAndEarn            String?   @map("sell_and_earn")

  @@index([sellerId])
  @@index([subCategoryId])
  @@map("products")
}

model Order {
  id                        String    @id @default(uuid()) @map("id")
  sellerId                  String    @map("seller_id")
  orderId                   String?   @map("order_id")
  trackingId                String?   @map("tracking_id")
  status                    String    @default("PENDING") @map("status")
  items                     String?   @map("items")
  totalAmount               Float?    @map("total_amount")
  customerName              String?   @map("customer_name")
  customerAddress           String?   @map("customer_address")
  customerPhone             String?   @map("customer_phone")
  paymentStatus             String?   @map("payment_status")
  productId                 String?   @map("product_id")
  storageType               String?   @map("storage_type")
  sellerPaymentStatus       String?   @map("seller_payment_status")
  itemPrice                 Float?    @map("item_price")
  buyerEmail                String?   @map("buyer_email")
  estimatedDelivery         DateTime? @map("estimated_delivery")
  productOption             Json?     @map("product_option")
  deliveredDate             DateTime? @map("delivered_date")
  invoiceNumber             String?   @map("invoice_number")
  returnAndExchangeDate     DateTime? @map("return_and_exchange_date")
  invoice                   String?   @map("invoice")
  refundStatus              String?   @map("refund_status")
  reason                    String?   @map("reason")
  message                   String?   @map("message")
  deliveryPartner           String?   @map("delivery_partner")
  deliveryPincode           String?   @map("delivery_pincode")
  addressLine1              String?   @map("address_line1")
  city                      String?   @map("city")
  state                     String?   @map("state")
  country                   String?   @map("country")
  razorpayOrderId           String?   @map("razorpay_order_id")
  shipping                  String?   @map("shipping")
  productReturn             String?   @map("product_return")
  returnOrderId             String?   @map("return_order_id")
  exchangeOrderId           String?   @map("exchange_order_id")
  returnDate                DateTime? @map("return_date")
  exchangeDate              DateTime? @map("exchange_date")
  returnExchange            String?   @map("return_exchange")
  mrp                       Float?    @map("mrp")
  onsalePrice               Float?    @map("onsale_price")
  discount                  Float?    @map("discount")
  gst                       Float?    @map("gst")
  hsn                       String?   @map("hsn")
  createdDate               DateTime  @default(now()) @map("created_date")
  updatedDate               DateTime  @updatedAt @map("updated_date")
  owner                     String?   @map("owner")
  paymentMode               String?   @map("payment_mode")
  deliveryFee               Float?    @map("delivery_fee")
  productImage              String?   @map("product_image")
  codDeliveryFee            Float?    @map("cod_delivery_fee")
  upiDeliveryFee            Float?    @map("upi_delivery_fee")
  quantity                  Int?      @map("quantity")
  paymentMethod             String?   @map("payment_method")
  deliveryCharge            Boolean?  @map("delivery_charge")
  couponDiscount            Float?    @map("coupon_discount")
  couponCode                String?   @map("coupon_code")
  returnExchangeTrackingId  String?   @map("return_exchange_tracking_id")
  returnOrderTrackingId     String?   @map("return_order_tracking_id")
  pickupAddress             String?   @map("pickup_address")
  usedWalletAmount          Float?    @map("used_wallet_amount")
  haatzaFreeDelivery        Boolean?  @default(false) @map("haatza_free_delivery")

  @@index([sellerId])
  @@map("orders")
}

model Warehouse {
  id        String   @id @default(uuid()) @map("warehouse_id")
  sellerId  String   @map("seller_id")
  name      String   @map("name")
  address   String   @map("address")
  pincode   String   @map("pincode")
  city      String   @map("city")
  state     String   @map("state")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([sellerId])
  @@map("warehouses")
}

model SellerSubscription {
  id                 String                      @id @default(uuid()) @db.VarChar(36)
  sellerId           String                      @map("seller_id") @db.VarChar(50)
  email              String                      @db.VarChar(100)
  phone              String?                     @db.VarChar(20)
  planId             String                      @map("plan_id") @db.VarChar(36)
  planName           String                      @map("plan_name") @db.VarChar(50)
  startedDate        DateTime                    @map("started_date")
  endedDate          DateTime                    @map("ended_date")
  gracePeriodDays    Int                         @default(0) @map("grace_period_days")
  gracePeriodEndDate DateTime?                   @map("grace_period_end_date")
  status             String                      @default("ACTIVE") @db.VarChar(20)
  paymentId          String?                     @map("payment_id") @db.VarChar(100)
  razorpayOrderId    String?                     @map("razorpay_order_id") @db.VarChar(100)
  autoRenew          Boolean                     @default(true) @map("auto_renew")
  cancelledAt        DateTime?                   @map("cancelled_at")
  createdAt          DateTime                    @default(now()) @map("created_at")
  invoices           SellerSubscriptionInvoice[]

  @@index([sellerId])
  @@index([planId])
  @@index([status])
  @@index([planId], map: "idx_seller_subscriptions_plan_id")
  @@index([sellerId], map: "idx_seller_subscriptions_seller_id")
  @@index([status], map: "idx_seller_subscriptions_status")
  @@map("seller_subscriptions")
}

model SellerSubscriptionInvoice {
  id                String             @id @default(uuid()) @db.VarChar(36)
  subscriptionId    String             @map("subscription_id") @db.VarChar(36)
  sellerId          String             @map("seller_id") @db.VarChar(50)
  invoiceDate       DateTime           @map("invoice_date")
  sellerName        String             @map("seller_name") @db.VarChar(100)
  gstin             String?            @db.VarChar(20)
  address           String?
  itemName          String             @map("item_name") @db.VarChar(100)
  rate              Decimal            @db.Decimal(12, 2)
  subtotal          Decimal            @db.Decimal(12, 2)
  couponCode        String?            @map("coupon_code") @db.VarChar(50)
  couponType        String?            @map("coupon_type") @db.VarChar(20)
  couponValue       Decimal?           @default(0.00) @map("coupon_value") @db.Decimal(12, 2)
  discountAmount    Decimal?           @default(0.00) @map("discount_amount") @db.Decimal(12, 2)
  taxableAmount     Decimal            @map("taxable_amount") @db.Decimal(12, 2)
  cgst              Decimal?           @default(0.00) @db.Decimal(12, 2)
  sgst              Decimal?           @default(0.00) @db.Decimal(12, 2)
  walletAmountUsed  Decimal?           @default(0.00) @map("wallet_amount_used") @db.Decimal(12, 2)
  upiAmountPaid     Decimal?           @default(0.00) @map("upi_amount_paid") @db.Decimal(12, 2)
  totalPayable      Decimal            @map("total_payable") @db.Decimal(12, 2)
  transactionMethod String             @map("transaction_method") @db.VarChar(30)
  paymentId         String?            @map("payment_id") @db.VarChar(100)
  razorpayOrderId   String?            @map("razorpay_order_id") @db.VarChar(100)
  createdAt         DateTime           @default(now()) @map("created_at")
  subscription      SellerSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([sellerId])
  @@index([subscriptionId], map: "idx_seller_subscription_invoices_subscription_id")
  @@map("seller_subscription_invoices")
}

model SubscriptionCoupon {
  id                String   @id @default(uuid()) @db.VarChar(36)
  code              String   @unique @db.VarChar(50)
  discountType      String   @map("discount_type") @db.VarChar(20)
  discountValue     Decimal  @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount    Decimal? @default(0.00) @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(12, 2)
  startDate         DateTime @map("start_date")
  endDate           DateTime @map("end_date")
  usageLimit        Int?     @map("usage_limit")
  usageCount        Int      @default(0) @map("usage_count")
  status            String   @default("ACTIVE") @db.VarChar(20)
  applicablePlanId  String?  @map("applicable_plan_id") @db.VarChar(36)
  description       String?
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([code])
  @@index([status])
  @@index([code], map: "idx_coupons_code")
  @@map("subscription_coupons")
}

model SellerWallet {
  id               String              @id @default(uuid()) @db.Uuid
  sellerId         String              @unique @map("seller_id") @db.VarChar(50)
  totalAddedAmount Decimal?            @map("total_added_amount") @db.Decimal(20, 2)
  gstAmount        Decimal?            @map("gst_amount") @db.Decimal(20, 2)
  usableBalance    Decimal?            @map("usable_balance") @db.Decimal(20, 2)
  remainingBalance Decimal?            @map("remaining_balance") @db.Decimal(20, 2)
  owner            String?             @map("owner") @db.Uuid
  createdDate      DateTime?           @default(now()) @map("created_date") @db.Timestamptz
  updatedDate      DateTime?           @updatedAt @map("updated_date") @db.Timestamptz
  transactions     WalletTransaction[]

  @@index([sellerId])
  @@index([sellerId], map: "idx_seller_wallet_seller_id")
  @@map("seller_wallet")
}

model WalletTransaction {
  id                String        @id @default(uuid()) @db.Uuid
  sellerId          String        @map("seller_id") @db.VarChar(50)
  transactionType   String?       @map("transaction_type") @db.VarChar(20)
  transactionAmount Decimal?      @map("transaction_amount") @db.Decimal(20, 2)
  gstDeducted       Decimal?      @map("gst_deducted") @db.Decimal(20, 2)
  remainingBalance  Decimal?      @map("remaining_balance") @db.Decimal(20, 2)
  campaignId        String?       @map("campaign_id") @db.VarChar(100)
  createdDate       DateTime?     @default(now()) @map("created_date") @db.Timestamptz
  campaignSpends    Boolean?      @default(false) @map("campaign_spends")
  total             Decimal?      @map("total") @db.Decimal(20, 2)
  paymentId         String?       @map("payment_id") @db.VarChar(100)
  sellerWallet      SellerWallet  @relation(fields: [sellerId], references: [sellerId], onDelete: Cascade)

  @@index([sellerId])
  @@map("wallet_transactions")
}

model SellerReferral {
  id            String                @id @default(uuid()) @db.VarChar(36)
  sellerId      String                @unique @map("seller_id") @db.VarChar(50)
  referralCode  String                @unique @map("referral_code") @db.VarChar(50)
  referralLink  String?               @map("referral_link") @db.VarChar(255)
  pointsBalance Decimal               @default(0.00) @map("points_balance") @db.Decimal(12, 2)
  totalEarned   Decimal               @default(0.00) @map("total_earned") @db.Decimal(12, 2)
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  history       ReferralTransaction[]

  @@index([sellerId])
  @@index([referralCode])
  @@index([sellerId], map: "idx_seller_referrals_seller_id")
  @@map("seller_referrals")
}

model ReferralTransaction {
  id               String         @id @default(uuid()) @db.VarChar(36)
  referralId       String         @map("referral_id") @db.VarChar(36)
  sellerId         String         @map("seller_id") @db.VarChar(50)
  referredSellerId String?        @map("referred_seller_id") @db.VarChar(50)
  points           Decimal        @db.Decimal(12, 2)
  type             String         @db.VarChar(20)
  description      String?        @db.VarChar(255)
  createdAt        DateTime       @default(now()) @map("created_at")
  referral         SellerReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([sellerId])
  @@map("referral_transactions")
}

model UserLoginHistory {
  id            String      @id @default(uuid()) @map("login_id")
  userId        String?     @map("user_id")
  identifier    String      @map("identifier")
  failureReason String?     @map("failure_reason")
  ipAddress     String?     @map("ip_address")
  userAgent     String?     @map("user_agent")
  deviceName    String?     @map("device_name")
  createdAt     DateTime    @default(now()) @map("created_at")
  status        LoginStatus @map("status")
  user          User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([identifier])
  @@index([userId], map: "idx_user_login_histories_user_id")
  @@map("user_login_histories")
}

model Dashboard {
  id           String           @id @default(dbgenerated("fn_next_dashboard_id()")) @map("id")
  widgetType   String?          @map("widget_type")
  widgetId     String           @map("widget_id")
  title        String?          @map("title")
  status       String?          @default("ACTIVE") @map("status")
  sequence     Int?             @map("sequence")
  categoryId   String?          @map("category_id")
  categoryName String?          @map("category_name")
  warehouseId  String?          @map("warehouse_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  expiresAt    DateTime?        @map("expires_at")
  module       DashboardModule? @default(HAATZA) @map("module")
  item         Json?            @map("Item")

  @@index([widgetId])
  @@index([widgetType])
  @@index([module])
  @@map("dashboard")
}

model PageMaster {
  id              String           @id @default(uuid()) @map("id")
  pageCode        String           @unique @map("page_code")
  pageName        String           @map("page_name")
  route           String           @map("route")
  description     String?          @map("description")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePageMasters RolePageMaster[]

  @@map("page_master")
}

model RoleMaster {
  id              String            @id @default(uuid()) @map("id")
  roleName        String            @unique @map("role_name")
  roleCode        String            @unique @map("role_code")
  isActive        Boolean           @default(true) @map("is_active")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  description     String?           @map("description")
  rolePageMasters RolePageMaster[]
  userPageRoles   UserPageRole[]
  userRoles       UserRoleMapping[]

  @@map("role_master")
}

model RolePageMaster {
  id        String      @id @default(uuid()) @map("id")
  roleId    String      @map("role_id")
  pageCode  String      @map("page_code")
  pageName  String      @map("page_name")
  route     String      @map("route")
  canView   Boolean     @default(false) @map("can_view")
  canCreate Boolean     @default(false) @map("can_create")
  canEdit   Boolean     @default(false) @map("can_edit")
  canDelete Boolean     @default(false) @map("can_delete")
  pageId    String?     @map("page_id")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @default(now()) @updatedAt @map("updated_at")
  page      PageMaster? @relation(fields: [pageId], references: [id], onDelete: Restrict)
  role      RoleMaster  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageCode])
  @@index([roleId])
  @@index([pageId])
  @@index([roleId], map: "idx_role_page_master_role_id")
  @@index([pageId], map: "idx_role_page_master_page_id")
  @@map("role_page_master")
}

model UserPageRole {
  id     String     @id @default(uuid()) @map("id")
  userId String     @map("user_id")
  roleId String     @map("role_id")
  role   RoleMaster @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_page_role")
}

model UserRoleMapping {
  id         String     @id @default(uuid()) @map("id")
  userId     String     @map("user_id")
  roleId     String     @map("role_id")
  isActive   Boolean    @default(true) @map("is_active")
  assignedAt DateTime   @default(now()) @map("assigned_at")
  assignedBy String?    @map("assigned_by")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at")
  role       RoleMaster @relation(fields: [roleId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([roleId], map: "idx_user_role_role_id")
  @@index([userId], map: "idx_user_role_user_id")
  @@map("user_role")
}

model CategoryMaster {
  id               String           @id @default(uuid()) @map("id")
  categoryId       String           @unique @map("category_id")
  categoryName     String           @map("category_name")
  parentCategoryId String?          @map("parent_category_id")
  categoryType     CategoryType     @default(CATEGORY) @map("category_type")
  categoryImage    String?          @map("category_image")
  description      String?          @map("description")
  sequence         Int              @default(0) @map("sequence")
  status           CategoryStatus   @default(ACTIVE) @map("status")
  module           CategoryModule   @default(HAATZA) @map("module")
  createdBy        String?          @map("created_by")
  updatedBy        String?          @map("updated_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  parent           CategoryMaster?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [categoryId], onDelete: Cascade)
  children         CategoryMaster[] @relation("CategoryHierarchy")

  @@unique([categoryName, parentCategoryId, module])
  @@index([parentCategoryId])
  @@index([module])
  @@index([status])
  @@index([sequence])
  @@map("category_master")
}

model WarehouseMaster {
  id                           String   @id @default(uuid()) @map("id")
  warehouseId                  String   @unique(map: "idx_warehouse_master_id") @map("warehouse_id")
  warehouseName                String   @map("warehouse_name")
  warehouseType                String?  @map("warehouse_type")
  franchiseCode                String?  @map("franchise_code")
  ownerName                    String?  @map("owner_name")
  contactPhone                 String?  @map("contact_phone")
  contactEmail                 String?  @map("contact_email")
  addressLine1                 String?  @map("address_line_1")
  addressLine2                 String?  @map("address_line_2")
  city                         String?  @map("city")
  state                        String?  @map("state")
  pincode                      String?  @map("pincode")
  latitude                     Decimal  @map("latitude") @db.Decimal(10, 7)
  longitude                    Decimal  @map("longitude") @db.Decimal(10, 7)
  serviceRadiusKm              Decimal  @default(10.0) @map("service_radius_km") @db.Decimal(10, 2)
  status                       String   @default("ACTIVE") @map("status")
  operatingStartTime           String?  @default("07:00:00") @map("operating_start_time")
  operatingEndTime             String?  @default("22:00:00") @map("operating_end_time")
  estimatedDeliveryTimeMinutes Int?     @default(10) @map("estimated_delivery_time_minutes")
  createdDate                  DateTime @default(now()) @map("created_date")
  updatedDate                  DateTime @default(now()) @updatedAt @map("updated_date")
  owner                        String?  @map("owner")
  accountManager               String?  @map("account_manager")
  managerPhone                 String?  @map("manager_phone")

  @@index([status])
  @@index([latitude, longitude], map: "idx_warehouse_master_location")
  @@index([status], map: "idx_warehouse_master_status")
  @@map("warehouse_master")
}

model AppbarCategory {
